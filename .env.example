# Vault receiving address (Robinhood Chain) — update via hosting env when rotating
NEXT_PUBLIC_RECEIVING_ADDRESS=0xdccbFd7A2562e2263E1036338C83dc79F5a4819D

# Optional: Alchemy API key for reliable mainnet RPC. If unset, falls back to public RPC.
# Get one at https://www.alchemy.com/ -> Create app -> Robinhood Chain -> copy key
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Set to "true" to use testnet (chain 46630, rpc.testnet.chain.robinhood.com) for staging
NEXT_PUBLIC_USE_TESTNET=false

# WalletConnect Cloud project ID for RainbowKit. Get at https://cloud.walletconnect.com
# A dummy value works for local dev but shows a warning; set a real one for production.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=demo-project-id

# Raise config (optional)
NEXT_PUBLIC_RAISE_TARGET_ETH=50
NEXT_PUBLIC_CUTOFF_DATE=2026-09-30T23:59:59Z

# Supabase — project qytucxmxqctypczvjeou (https://qytucxmxqctypczvjeou.supabase.co)
# For prod, replace SUPABASE_SERVICE_ROLE_KEY with real service_role from dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://qytucxmxqctypczvjeou.supabase.co
